# Copy this file to .env and fill in the values.

# Riot API key: https://developer.riotgames.com (a dev key expires every 24h;
# request a "Personal API Key" so you don't have to renew it).
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional. Pick your account inside the app: search your Riot ID at the top of the page and set it
# as favorite. The favorite wins over this line, which is only used until you choose one.
# With neither, the account open in the LoL client is used.
# Each account's games, stats and LP history are kept apart; the app only shows the active one's.
RIOT_ID=

# Server: euw1 / eun1 / na1 / br1 / kr ...  and the matching routing region
PLATFORM=euw1
REGION=europe

# Optional: LoL install folder, only if the app can't find the client by itself.
# LOL_PATH=C:\Riot Games\League of Legends

PORT=8765

# Start of the season (match history fetches games from this date)
SEASON_START=2026-01-08
