# Copy this file to .env and fill in the values.

# Riot API key: https://developer.riotgames.com (a dev key expires every 24h;
# request a "Personal API Key" so you don't have to renew it).
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Your Riot ID (Name#TAG). If empty, the account open in the LoL client is used.
# Changing it to another account deletes the old account's games/stats/LP history on the
# next start and downloads the new one's (high elo games and mains are kept).
RIOT_ID=Name#EUW

# Server: euw1 / eun1 / na1 / br1 / kr ...  and the matching routing region
PLATFORM=euw1
REGION=europe

# Optional: LoL install folder, only if the app can't find the client by itself.
# LOL_PATH=C:\Riot Games\League of Legends

PORT=8765

# Start of the season (match history fetches games from this date)
SEASON_START=2026-01-08
